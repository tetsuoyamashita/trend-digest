---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Trend Digest', description = 'Daily trend digest for personal use' } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="stylesheet" href="/trend-digest/pagefind/pagefind-ui.css" onerror="this.remove()" />
  <style>
    :root {
      --bg: #fafafa;
      --fg: #111;
      --muted: #666;
      --accent: #2563eb;
      --border: #e5e7eb;
      --high: #dc2626;
      --mid: #d97706;
      --low: #9ca3af;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif;
      background: var(--bg);
      color: var(--fg);
      margin: 0;
      line-height: 1.6;
    }
    .container { max-width: 1100px; margin: 0 auto; padding: 1rem; }
    header { border-bottom: 1px solid var(--border); padding: 1rem 0; }
    h1 { margin: 0; font-size: 1.5rem; }
    nav.tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
    nav.tabs a {
      padding: 0.4rem 0.8rem; border: 1px solid var(--border); border-radius: 4px;
      text-decoration: none; color: var(--fg); font-size: 0.9rem;
    }
    nav.tabs a.active { background: var(--accent); color: white; border-color: var(--accent); }
    .controls { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin: 1rem 0; }
    .controls input, .controls select {
      padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 4px;
      font-size: 0.9rem; background: white;
    }
    .controls input[type=search] { flex: 1; min-width: 200px; }
    footer { color: var(--muted); font-size: 0.8rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>📡 Trend Digest</h1>
    </header>
    <slot />
    <footer>
      <p>Daily trend digest dashboard. v0.2.2 (skeleton). Last build: <span id="last-build">{new Date().toISOString()}</span></p>
    </footer>
  </div>
</body>
</html>
