---
interface Props {
  title?: string;
}
const { title = 'Trend Digest' } = Astro.props;
const buildTime = new Date().toISOString();
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <meta name="description" content="Daily trend digest dashboard" />
  <link rel="stylesheet" href="/trend-digest/pagefind/pagefind-ui.css" onerror="this.remove()" />
  <style is:global>
    :root {
      --bg: #1f232b;
      --bg-elev: #252932;
      --bg-row-hover: #272b34;
      --bg-row-selected: #2c3140;
      --fg: #d8dade;
      --fg-strong: #f3f4f7;
      --fg-muted: #8a8f9a;
      --fg-dim: #5e636e;
      --border: #2f3440;
      --border-soft: #2a2e38;
      --accent: #4a8cff;
      --accent-soft: #2a4170;
      --cat-ai_ml: #4a8cff;
      --cat-tech: #4ec27a;
      --cat-mgmt: #b485ff;
      --cat-startup_vc: #ff7aa8;
      --cat-invest: #f0c845;
      --cat-policy: #ff6b6b;
      --cat-geopolitics: #ff9355;
      --cat-consumer: #c9966b;
      --cat-academia: #9aa1ad;
      --row-h: 26px;
      --font-mono: 'JetBrains Mono', 'IBM Plex Mono', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
      --font-sans: 'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Yu Gothic UI', sans-serif;
      --font-size: 13px;
    }
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap');
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
    body {
      font-family: var(--font-mono);
      font-size: var(--font-size);
      line-height: 1.5;
      min-height: 100vh;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    button {
      background: transparent; color: var(--fg); border: 1px solid var(--border);
      font-family: var(--font-mono); font-size: var(--font-size); cursor: pointer;
      padding: 2px 8px; border-radius: 3px;
    }
    button:hover { background: var(--bg-elev); border-color: var(--fg-dim); }
    button.active { background: var(--accent-soft); border-color: var(--accent); color: var(--fg-strong); }
    input[type=search], input[type=text] {
      background: var(--bg-elev); color: var(--fg); border: 1px solid var(--border);
      font-family: var(--font-mono); font-size: var(--font-size); padding: 3px 8px; border-radius: 3px;
      outline: none;
    }
    input[type=search]:focus, input[type=text]:focus { border-color: var(--accent); }
    .cat-tag {
      font-family: var(--font-mono); font-size: var(--font-size); white-space: nowrap;
      letter-spacing: 0;
    }
    .cat-tag::before { content: '['; }
    .cat-tag::after { content: ']'; }
    .cat-AI\/ML { color: var(--cat-ai_ml); }
    .cat-テック { color: var(--cat-tech); }
    .cat-経営・戦略 { color: var(--cat-mgmt); }
    .cat-SU・VC { color: var(--cat-startup_vc); }
    .cat-投資・マーケット { color: var(--cat-invest); }
    .cat-政策・規制 { color: var(--cat-policy); }
    .cat-地政学 { color: var(--cat-geopolitics); }
    .cat-消費者 { color: var(--cat-consumer); }
    .cat-アカデミア { color: var(--cat-academia); }
  </style>
</head>
<body data-build-time={buildTime}>
  <slot />
</body>
</html>
