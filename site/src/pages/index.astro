---
import Layout from '../layouts/Layout.astro';
import articlesData from '../data/articles.sample.json';

interface Article {
  id: string;
  title: string;
  title_ja?: string;
  url: string;
  summary_ja: string;
  summary_long_ja?: string;
  categories: string[];
  source_media: string;
  source_feed?: string;
  source_lang: string;
  fetched_date: string;
  important?: boolean;
}

const CATEGORIES = ['AI/ML', 'テック', '経営・戦略', 'SU・VC', '投資・マーケット', '政策・規制', '地政学', '消費者', 'アカデミア'];
const CAT_INDEX: Record<string, number> = Object.fromEntries(CATEGORIES.map((c, i) => [c, i]));
const sortCats = (cats: string[]) =>
  cats.slice().sort((a, b) => (CAT_INDEX[a] ?? 999) - (CAT_INDEX[b] ?? 999));
const CAT_DISPLAY: Record<string, string> = {
  'AI/ML': 'AI',
  '経営・戦略': '経営',
  'SU・VC': 'VC',
  '投資・マーケット': '投資',
  '政策・規制': '政策',
};
const displayCat = (c: string) => CAT_DISPLAY[c] ?? c;
const PERIODS = [
  { id: 'yesterday', label: '昨日' },
  { id: '3d',        label: '3日' },
  { id: '7d',        label: '7日' },
  { id: '30d',       label: '30日' },
  { id: '1y',        label: '1年' },
  { id: 'all',       label: '全期間' },
];

const articles: Article[] = (articlesData as Article[])
  .slice()
  .sort((a, b) => (b.fetched_date || '').localeCompare(a.fetched_date || ''));

const totalAll = articles.length;
function countCategory(cat: string): number {
  return articles.filter(a => a.categories.includes(cat)).length;
}
const buildTimeJST = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit',
  hour: '2-digit', minute: '2-digit', hour12: false,
}).format(new Date());
---
<Layout title="Trend Digest">
  <header class="topbar">
    <div class="topbar-row logo-row">
      <span class="logo">▲ Trend Digest</span>
      <span class="meta">updated {buildTimeJST} JST · <span id="visible-count">{totalAll}</span> 件</span>
    </div>
    <div class="topbar-row filter-row">
      <div class="period-pills" role="tablist" aria-label="期間">
        {PERIODS.map((p, idx) => (
          <button class={'pill ' + (idx === 0 ? 'active' : '')} data-period={p.id}>
            [{p.label} <span class="pill-count" data-count-period={p.id}>0</span>]
          </button>
        ))}
      </div>
      <label class="important-filter" title="重要フラグの記事のみ表示">
        <input type="checkbox" id="important-only" />
        <span class="important-filter-icon">★</span> 重要のみ
      </label>
      <div id="search" class="search-slot"></div>
    </div>
    <div class="topbar-row category-row">
      <button class="pill cat-pill active" data-category="all">[All <span class="pill-count" data-count-cat="all">{totalAll}</span>]</button>
      {CATEGORIES.map(c => (
        <button class={'pill cat-pill cat-' + c} data-category={c}>
          [{displayCat(c)} <span class="pill-count" data-count-cat={c}>{countCategory(c)}</span>]
        </button>
      ))}
    </div>
  </header>

  <main class="layout">
    <section class="list" id="list">
      {articles.map((a, i) => (
        <div
          class="row"
          data-id={a.id}
          data-title={a.title}
          data-title-ja={a.title_ja ?? ''}
          data-url={a.url}
          data-summary={a.summary_ja}
          data-summary-long={a.summary_long_ja ?? ''}
          data-categories={sortCats(a.categories).join(',')}
          data-source-media={a.source_media}
          data-source-feed={a.source_feed ?? ''}
          data-source-lang={a.source_lang ?? 'other'}
          data-fetched-date={a.fetched_date ?? ''}
          data-default-important={a.important ? '1' : '0'}
          data-pagefind-body
        >
          <button type="button" class="star-btn" data-star-for={a.id} aria-label="重要フラグ" title="重要フラグ ON/OFF">☆</button>
          <span class="col-num">[{String(i + 1).padStart(3, '0')}]</span>
          <span class="col-sep">│</span>
          <span class="col-title">{a.title_ja || a.title}</span>
          <span class="col-cats">
            {sortCats(a.categories).map(c => (
              <span class={'cat-tag cat-' + c}>{displayCat(c)}</span>
            ))}
          </span>
        </div>
      ))}
    </section>
    <aside class="panel" id="panel" aria-live="polite">
      <div class="panel-inner">
        <div class="panel-title-row">
          <button type="button" class="star-btn star-btn-panel" id="p-star" aria-label="重要フラグ" title="重要フラグ ON/OFF" hidden>☆</button>
          <h1 class="panel-title" id="p-title">記事を選択してください</h1>
        </div>
        <div class="panel-meta" id="p-meta">
          <span id="p-source-media">—</span>
          <span class="dot">·</span>
          <span id="p-source-feed">—</span>
          <span class="dot">·</span>
          <span id="p-fetched-date">—</span>
          <span class="dot">·</span>
          <span id="p-lang">—</span>
          <span class="dot">·</span>
          <span id="p-cats" class="panel-cats"></span>
          <span class="dot">·</span>
          <a id="p-source-link" class="panel-source-link" href="#" target="_blank" rel="noopener">原文リンク ↗</a>
        </div>
        <hr class="panel-divider" />
        <div class="panel-summary" id="p-summary">左のリストから記事を選択すると、ここに詳細要約が表示されます。</div>
        <button class="panel-expand-btn" id="p-expand" type="button" aria-expanded="false" aria-controls="p-long" hidden>▼ 原文を読む（詳細要約を表示）</button>
        <div class="panel-long" id="p-long" hidden></div>
      </div>
    </aside>
  </main>

  <script src="/trend-digest/pagefind/pagefind-ui.js" is:inline onerror="this.remove()"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      try {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: '#search', showSubResults: false, resetStyles: false });
        }
      } catch (e) {}

      const CAT_DISPLAY = {
        'AI/ML': 'AI',
        '経営・戦略': '経営',
        'SU・VC': 'VC',
        '投資・マーケット': '投資',
        '政策・規制': '政策',
      };
      const displayCat = c => CAT_DISPLAY[c] || c;

      // 重要フラグ管理 (localStorage を真実とし、初期値は Notion DB の checkbox)
      const IMPORTANT_KEY = 'trend-digest-important-v1';
      function loadImportant() {
        try { return JSON.parse(localStorage.getItem(IMPORTANT_KEY) || '{}'); } catch { return {}; }
      }
      function saveImportant(map) {
        try { localStorage.setItem(IMPORTANT_KEY, JSON.stringify(map)); } catch {}
      }
      let importantMap = loadImportant();
      function isImportant(id) {
        if (!id) return false;
        if (Object.prototype.hasOwnProperty.call(importantMap, id)) return !!importantMap[id];
        const row = document.querySelector('.row[data-id="' + CSS.escape(id) + '"]');
        return row ? row.getAttribute('data-default-important') === '1' : false;
      }
      function setImportant(id, value) {
        importantMap[id] = !!value;
        saveImportant(importantMap);
      }

      let activePeriod = 'yesterday';
      let activeCategory = 'all';
      let importantOnly = false;
      const rows = Array.from(document.querySelectorAll('.row'));

      function todayJST() {
        const now = new Date();
        const tz = new Date(now.getTime() + 9 * 3600 * 1000);
        return tz.toISOString().slice(0, 10);
      }
      function yesterdayJST() {
        const t = new Date(todayJST() + 'T00:00:00Z');
        t.setUTCDate(t.getUTCDate() - 1);
        return t.toISOString().slice(0, 10);
      }
      const YESTERDAY = yesterdayJST();

      // 期間は「昨日」を基準にした N 日間 (昨日含む)
      // 例: 3日 = 昨日 / 一昨日 / 3 日前 の 3 日分
      const PERIOD_DAYS = { '3d': 3, '7d': 7, '30d': 30, '1y': 365 };
      function inPeriod(fetchedDate, periodId) {
        if (periodId === 'all') return true;
        if (!fetchedDate) return false;
        if (periodId === 'yesterday') return fetchedDate === YESTERDAY;
        const days = PERIOD_DAYS[periodId];
        if (!days) return true;
        const d0 = new Date(YESTERDAY + 'T00:00:00Z').getTime();
        const d1 = new Date(fetchedDate + 'T00:00:00Z').getTime();
        const diff = (d0 - d1) / (24 * 3600 * 1000);
        return diff >= 0 && diff < days;
      }

      const PERIOD_IDS = ['yesterday', '3d', '7d', '30d', '1y', 'all'];

      function applyFilter() {
        let visible = 0;
        const catCounts = { all: 0 };
        const perCounts = {};
        PERIOD_IDS.forEach(p => { perCounts[p] = 0; });
        rows.forEach(r => {
          const fd = r.getAttribute('data-fetched-date') || '';
          const cats = (r.getAttribute('data-categories') || '').split(',').filter(Boolean);
          const id = r.getAttribute('data-id');
          const imp = isImportant(id);
          for (const p of PERIOD_IDS) if (inPeriod(fd, p)) perCounts[p]++;
          const periodOK = inPeriod(fd, activePeriod);
          const catOK = activeCategory === 'all' || cats.includes(activeCategory);
          const impOK = !importantOnly || imp;
          const show = periodOK && catOK && impOK;
          r.style.display = show ? '' : 'none';
          if (show) visible++;
          if (periodOK && impOK) {
            catCounts.all++;
            cats.forEach(c => { catCounts[c] = (catCounts[c] || 0) + 1; });
          }
        });
        document.getElementById('visible-count').textContent = String(visible);
        document.querySelectorAll('[data-count-period]').forEach(el => {
          const k = el.getAttribute('data-count-period');
          el.textContent = String(perCounts[k] || 0);
        });
        document.querySelectorAll('[data-count-cat]').forEach(el => {
          const k = el.getAttribute('data-count-cat');
          el.textContent = String(catCounts[k] || 0);
        });
      }

      // 初期描画: 各 row の ☆ 状態を localStorage または default で更新
      function refreshStarBtn(btn, id) {
        const on = isImportant(id);
        btn.textContent = on ? '★' : '☆';
        btn.classList.toggle('on', on);
        btn.setAttribute('aria-pressed', String(on));
      }
      rows.forEach(r => {
        const id = r.getAttribute('data-id');
        const btn = r.querySelector('.star-btn');
        if (btn) {
          refreshStarBtn(btn, id);
          btn.addEventListener('click', e => {
            e.stopPropagation();
            const next = !isImportant(id);
            setImportant(id, next);
            refreshStarBtn(btn, id);
            const pStar = document.getElementById('p-star');
            if (pStar && pStar.dataset.id === id) refreshStarBtn(pStar, id);
            applyFilter();
          });
        }
      });

      const importantOnlyBox = document.getElementById('important-only');
      if (importantOnlyBox) {
        importantOnlyBox.addEventListener('change', () => {
          importantOnly = importantOnlyBox.checked;
          applyFilter();
        });
      }

      const pStarBtn = document.getElementById('p-star');
      if (pStarBtn) {
        pStarBtn.addEventListener('click', () => {
          const id = pStarBtn.dataset.id;
          if (!id) return;
          const next = !isImportant(id);
          setImportant(id, next);
          refreshStarBtn(pStarBtn, id);
          const rowBtn = document.querySelector('.row[data-id="' + CSS.escape(id) + '"] .star-btn');
          if (rowBtn) refreshStarBtn(rowBtn, id);
          applyFilter();
        });
      }

      document.querySelectorAll('[data-period]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[data-period]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activePeriod = btn.getAttribute('data-period');
          applyFilter();
        });
      });

      document.querySelectorAll('[data-category]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[data-category]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeCategory = btn.getAttribute('data-category');
          applyFilter();
        });
      });

      function selectRow(row) {
        rows.forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        const get = k => row.getAttribute('data-' + k) || '';
        const id = get('id');
        document.getElementById('p-title').textContent = (get('title-ja') || get('title')) || '(no title)';
        document.getElementById('p-source-media').textContent = get('source-media') || '—';
        document.getElementById('p-source-feed').textContent = get('source-feed') || '—';
        document.getElementById('p-fetched-date').textContent = get('fetched-date') || '—';
        document.getElementById('p-lang').textContent = '[' + (get('source-lang') || 'other') + ']';
        const catsEl = document.getElementById('p-cats');
        catsEl.innerHTML = '';
        (get('categories') || '').split(',').filter(Boolean).forEach(c => {
          const span = document.createElement('span');
          span.className = 'cat-tag cat-' + c;
          span.textContent = displayCat(c);
          catsEl.appendChild(span);
        });
        if (pStarBtn) {
          pStarBtn.dataset.id = id;
          pStarBtn.hidden = false;
          refreshStarBtn(pStarBtn, id);
        }
        const summaryEl = document.getElementById('p-summary');
        summaryEl.innerHTML = renderSummary(get('summary'));

        const url = get('url') || '';
        const link = document.getElementById('p-source-link');
        if (url) { link.href = url; link.style.display = ''; }
        else { link.removeAttribute('href'); link.style.display = 'none'; }

        const longRaw = get('summary-long') || '';
        const longEl = document.getElementById('p-long');
        const btn = document.getElementById('p-expand');
        if (longRaw) {
          longEl.innerHTML = renderLongSummary(longRaw);
          btn.hidden = false;
          btn.setAttribute('aria-expanded', 'false');
          btn.textContent = '▼ 原文を読む（詳細要約を表示）';
          longEl.hidden = true;
        } else {
          longEl.innerHTML = '';
          btn.hidden = true;
          longEl.hidden = true;
        }
      }

      // Markdown lite: bullet lines starting with "* " or "- " => <ul><li>, **bold**, line breaks
      function escapeHtml(s) {
        return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      }
      function inlineFormat(s) {
        const e = escapeHtml(s);
        return e.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      }
      function renderSummary(raw) {
        if (!raw) return '<em class="muted">(no summary)</em>';
        const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
        const bullets = [];
        const paragraphs = [];
        let inBullet = false;
        const out = [];
        function flushPara() {
          if (paragraphs.length) {
            out.push('<p>' + paragraphs.map(inlineFormat).join('<br>') + '</p>');
            paragraphs.length = 0;
          }
        }
        function flushBullets() {
          if (bullets.length) {
            out.push('<ul>' + bullets.map(b => '<li>' + inlineFormat(b) + '</li>').join('') + '</ul>');
            bullets.length = 0;
          }
        }
        for (const line of lines) {
          const m = line.match(/^[\*\-・]\s+(.+)$/);
          if (m) { flushPara(); bullets.push(m[1]); inBullet = true; }
          else { flushBullets(); paragraphs.push(line); inBullet = false; }
        }
        flushBullets(); flushPara();
        return out.join('');
      }

      function renderLongSummary(raw) {
        if (!raw) return '';
        return raw.split(/\n{2,}/).map(p => p.trim()).filter(Boolean)
          .map(p => '<p>' + p.split(/\r?\n/).map(inlineFormat).join('<br>') + '</p>').join('');
      }

      const expandBtn = document.getElementById('p-expand');
      if (expandBtn) {
        expandBtn.addEventListener('click', () => {
          const longEl = document.getElementById('p-long');
          const open = !longEl.hidden;
          longEl.hidden = open;
          expandBtn.setAttribute('aria-expanded', String(!open));
          expandBtn.textContent = open ? '▼ 原文を読む（詳細要約を表示）' : '▲ 詳細要約を閉じる';
        });
      }

      rows.forEach(r => r.addEventListener('click', () => selectRow(r)));

      applyFilter();
      const firstVisible = rows.find(r => r.style.display !== 'none');
      if (firstVisible) selectRow(firstVisible);
      else if (rows[0]) selectRow(rows[0]);

      document.addEventListener('keydown', e => {
        if (e.target instanceof HTMLInputElement) return;
        const visible = rows.filter(r => r.style.display !== 'none');
        if (!visible.length) return;
        const cur = visible.findIndex(r => r.classList.contains('selected'));
        let next = cur;
        if (e.key === 'ArrowDown' || e.key === 'j') next = Math.min(visible.length - 1, cur + 1);
        else if (e.key === 'ArrowUp' || e.key === 'k') next = Math.max(0, cur - 1);
        else return;
        e.preventDefault();
        if (next !== cur && visible[next]) {
          selectRow(visible[next]);
          visible[next].scrollIntoView({ block: 'nearest' });
        }
      });
    });
  </script>

  <style>
    .topbar {
      position: sticky; top: 0; z-index: 10;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 8px 16px;
    }
    .topbar-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-height: 30px; }
    .topbar-row + .topbar-row { margin-top: 4px; }
    .logo { font-weight: 700; color: var(--fg-strong); font-size: 16px; letter-spacing: 0.5px; }
    .meta { color: var(--fg-muted); margin-left: auto; font-size: 12px; }
    .pill {
      background: transparent; border: none; padding: 2px 6px; color: var(--fg-muted);
      font-family: var(--font-mono); font-size: var(--font-size); cursor: pointer; line-height: 1.4;
      border-radius: 0;
    }
    .pill:hover { color: var(--fg); }
    .pill.active { color: var(--fg-strong); background: var(--accent-soft); }
    .pill.cat-pill { padding: 1px 4px; color: var(--pill-color, var(--fg-muted)); }
    .pill.cat-pill:hover { color: var(--pill-color, var(--fg)); filter: brightness(1.15); }
    .pill.cat-pill.active { color: var(--pill-color, var(--fg-strong)); background: var(--accent-soft); }
    .pill.cat-pill.cat-AI\/ML { --pill-color: var(--cat-ai_ml); }
    .pill.cat-pill.cat-テック { --pill-color: var(--cat-tech); }
    .pill.cat-pill.cat-経営・戦略 { --pill-color: var(--cat-mgmt); }
    .pill.cat-pill.cat-SU・VC { --pill-color: var(--cat-startup_vc); }
    .pill.cat-pill.cat-投資・マーケット { --pill-color: var(--cat-invest); }
    .pill.cat-pill.cat-政策・規制 { --pill-color: var(--cat-policy); }
    .pill.cat-pill.cat-地政学 { --pill-color: var(--cat-geopolitics); }
    .pill.cat-pill.cat-消費者 { --pill-color: var(--cat-consumer); }
    .pill.cat-pill.cat-アカデミア { --pill-color: var(--cat-academia); }
    .pill-count { color: var(--fg-dim); }
    .pill.active .pill-count { color: var(--fg-muted); }

    .important-filter {
      margin-left: auto;
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 8px;
      font-family: var(--font-mono); font-size: 13px;
      color: var(--fg-muted);
      cursor: pointer;
      user-select: none;
      border: 1px solid transparent;
      border-radius: 3px;
    }
    .important-filter:hover { color: var(--fg); }
    .important-filter input { margin: 0; cursor: pointer; }
    .important-filter:has(input:checked) {
      color: #f0c845;
      border-color: var(--border);
      background: var(--bg-elev);
    }
    .important-filter-icon { color: #f0c845; }

    .search-slot { width: 240px; }

    .layout {
      display: grid;
      grid-template-columns: 1fr minmax(540px, 50vw);
      height: calc(100vh - 110px);
      gap: 0;
    }
    .list {
      overflow-y: auto;
      border-right: 1px solid var(--border);
      padding: 4px 0;
    }
    .row {
      display: flex; align-items: center; gap: 8px;
      padding: 0 12px;
      height: var(--row-h);
      cursor: pointer;
      border-left: 3px solid transparent;
      white-space: nowrap; overflow: hidden;
      font-size: 14px;
    }
    .row:hover { background: var(--bg-row-hover); }
    .row.selected { background: var(--bg-row-selected); border-left-color: var(--accent); }
    .col-num { color: var(--fg-dim); flex: 0 0 auto; font-family: var(--font-mono); }
    .col-sep { color: var(--border); flex: 0 0 auto; font-family: var(--font-mono); }
    .col-title {
      flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; color: var(--fg);
      font-family: var(--font-sans);
      font-size: 14px;
    }
    .col-cats { flex: 0 0 auto; display: flex; gap: 4px; font-family: var(--font-mono); }

    .star-btn {
      flex: 0 0 auto;
      background: transparent;
      border: none;
      padding: 0 2px;
      color: var(--fg-dim);
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
      transition: transform 0.1s ease;
    }
    .star-btn:hover { color: #f0c845; transform: scale(1.15); }
    .star-btn.on { color: #f0c845; }
    .star-btn-panel { font-size: 18px; }

    .panel { background: var(--bg-elev); overflow-y: auto; }
    .panel-inner { padding: 16px 20px; }
    .panel-title-row {
      display: flex; align-items: center; gap: 8px;
      margin: 0 0 8px;
    }
    .panel-title {
      margin: 0;
      flex: 1 1 auto;
      font-family: var(--font-sans);
      font-size: 16px;
      font-weight: 700;
      color: var(--fg-strong);
      line-height: 1.5;
      letter-spacing: 0;
    }
    .panel-meta {
      color: var(--fg-muted);
      display: flex; flex-wrap: wrap; gap: 6px; align-items: center;
      font-family: var(--font-sans); font-size: 12px;
    }
    .panel-meta .dot { color: var(--fg-dim); }
    .panel-cats { display: inline-flex; gap: 6px; font-family: var(--font-mono); }
    .panel-source-link {
      color: var(--accent);
      text-decoration: none;
      font-family: var(--font-sans);
      font-size: 12px;
    }
    .panel-source-link:hover { text-decoration: underline; }
    .panel-divider { border: none; border-top: 1px solid var(--border); margin: 12px 0; }
    .panel-summary {
      color: var(--fg);
      font-family: var(--font-sans);
